+"""Backend-specific checks for the SpacemiT conv2d kernel.
+
+The forward numerics are covered by ``tests/test_conv2d.py`` (which runs
+forward-only on this backend).  These tests pin down the two properties that
+made the operator unusable in practice: it was not exported from
+``_spacemit/ops/__init__.py`` at all, and it silently ignored ``groups``.
+"""
+
+import pytest
+import torch
+
+import flag_gems
+
+from . import accuracy_utils as utils
+
+pytestmark = pytest.mark.skipif(
+    flag_gems.vendor_name != "spacemit",
+    reason="backend-specific check of the SpacemiT conv2d kernel",
+)
+
+
+def test_conv2d_vendor_kernel_registered():
+    # Guards the regression where _spacemit/ops/conv2d.py existed but was not
+    # exported from _spacemit/ops/__init__.py, so the generic kernel ran instead.
+    assert utils.gems_log_prefix(flag_gems.conv2d) == "GEMS_SPACEMIT"
+
+
+def test_conv2d_rejects_unsupported_arguments():
+    inp = torch.randn((1, 4, 8, 8), dtype=torch.float32, device=flag_gems.device)
+    weight = torch.randn((4, 4, 3, 3), dtype=torch.float32, device=flag_gems.device)
+    with pytest.raises(NotImplementedError):
+        flag_gems.conv2d(inp, weight, groups=2)
+    with pytest.raises(NotImplementedError):
+        flag_gems.conv2d(inp, weight, padding="same")
