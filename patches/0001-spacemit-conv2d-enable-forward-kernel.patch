@@ -193,8 +193,25 @@ def fused_im2col_bmm_kernel(
 
 
 def conv2d(input, weight, bias=None, padding=0, stride=1, dilation=1, groups=1):
+    """SpacemiT fused im2col + GEMM convolution for NCHW tensors.
+
+    Only ``groups=1`` and integer/tuple ``padding`` are implemented.  Grouped
+    (including depthwise) convolutions and string padding modes still need the
+    generic implementation, so unsupported values raise ``NotImplementedError``
+    instead of being silently ignored.
+    """
     logger.debug("GEMS_SPACEMIT CONV2D")
 
+    if groups != 1:
+        raise NotImplementedError(
+            f"GEMS_SPACEMIT CONV2D supports groups=1 only, received groups={groups}"
+        )
+    if isinstance(padding, str):
+        raise NotImplementedError(
+            "GEMS_SPACEMIT CONV2D requires int or tuple padding, "
+            f"received padding={padding!r}"
+        )
+
     N, C, H, W = input.shape
     OC, _, KH, KW = weight.shape
 
